{
  "name": "huddle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "vercel-build": "tsx scripts/migrate.ts && next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:content": "vitest run tests/unit/content",
    "test:e2e": "tsx scripts/build.ts && playwright test",
    "test:real": "tsx scripts/build.ts && tsx scripts/test-real.ts",
    "test:deploy": "playwright test -c playwright.deploy.config.ts",
    "probe:draw": "tsx scripts/probe-draw.ts",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "env:check": "tsx scripts/env-check.ts",
    "ci": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "build:content": "tsx scripts/build-content.ts && tsx scripts/make-bot-drawings.ts",
    "build:icons": "tsx scripts/make-icons.ts"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.3",
    "ably": "^2.30.0",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
